@model List<WorkFlowBasic.Models.ViewModels.UserRoleViewModel>
@{
    ViewData["Title"] = "Kullanıcı ve Rol Yönetimi";
}

<h3><i class="bi bi-person-badge-fill text-primary"></i> Kullanıcı ve Rol Yönetimi</h3>
<p class="text-muted">Kullanıcıların yetkilerini (Rollerini) buradan değiştirebilirsiniz.</p>
<hr />

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Mevcut Rol</th>
                    <th>Rolü Değiştir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.CurrentRole == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (user.CurrentRole == "Manager")
                            {

                                <span class="badge bg-warning text-dark">Müdür</span>
                            }
                            else
                            {

                                <span class="badge bg-info text-dark">Personel</span>
                            }
                        </td>
                        <td>
                            <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                <input type="hidden" name="userId" value="@user.UserId" />

                                <select name="newRole" class="form-select form-select-sm w-auto">
                                    <option value="Personel" selected="@(user.CurrentRole == "Personel")">Personel</option>
                                    <option value="Manager" selected="@(user.CurrentRole == "Manager")">Müdür</option>
                                    <option value="Admin" selected="@(user.CurrentRole == "Admin")">Admin</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-outline-primary" onclick="return confirm('Bu kullanıcının yetkisini değiştirmek istediğinize emin misiniz?')">
                                    <i class="bi bi-save"></i> Kaydet
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>