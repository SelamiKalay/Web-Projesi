@model WorkFlowBasic.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-warning text-dark text-center py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-lock-fill"></i> Güvenlik Ayarları
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:none;"></div>
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <div asp-validation-summary="All" class="mb-0"></div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">Mevcut Şifreniz</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="CurrentPassword" class="form-control" placeholder="Şu anki şifrenizi girin" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">Yeni Şifre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="NewPassword" class="form-control" placeholder="Yeni güçlü şifreniz" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Yeni şifreyi doğrulayın" />
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-check-circle-fill me-2"></i> Şifreyi Güncelle
                            </button>
                            <a href="/Home/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> İptal ve Geri Dön
                            </a>
                        </div>

                    </form>
                </div>

                <div class="card-footer text-center text-muted small py-3">
                    Güvenliğiniz için şifrenizi kimseyle paylaşmayınız.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}