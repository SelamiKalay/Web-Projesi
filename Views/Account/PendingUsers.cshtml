@model IEnumerable<WorkFlowBasic.Models.ApplicationUser>
@{
    ViewData["Title"] = "Personel Onayları";
}

<h3>👥 Personel Başvuruları</h3>
<p class="text-muted">Aşağıdaki kişiler sisteme kayıt oldu ancak henüz giriş onayları verilmedi.</p>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> Bekleyen yeni başvuru yok. Herkes onaylı.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Email</th>
                        <th>Departman</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-secondary">@user.Department</span></td>
                            <td class="text-end">
                                <a href="/Account/ReviewUser?userId=@user.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-search"></i> İncele ve Karar Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}