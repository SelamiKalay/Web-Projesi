@{
    ViewData["Title"] = "Şirket Takvimi";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary"><i class="bi bi-calendar-check"></i> Şirket İzin Takvimi</h5>
            <span class="badge bg-success">Sadece Onaylı İzinler</span>
        </div>
        <div class="card-body">
            <div id='calendar'></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', // Aylık görünüm
                locale: 'tr', // Türkçe dil desteği
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,multiMonthYear' // Yıl görünümü eklendi
                },
                buttonText: {
                    today: 'Bugün',
                    month: 'Ay',
                    week: 'Hafta',
                    year: 'Yıl', // Çeviri
                    list: 'Liste'
                },
                events: '/Calendar/GetEvents', // Veriyi buradan çekecek (Az önce yazdığımız Controller)
                eventClick: function(info) {
                    if (info.event.url) {
                        window.open(info.event.url, "_blank"); // Tıklayınca yeni sekmede aç
                        return false;
                    }
                }
            });

            calendar.render();
        });
    </script>

    <style>
        #calendar {
            min-height: 600px;
        }

        .fc-event {
            cursor: pointer;
        }
    </style>
}