@using Microsoft.AspNetCore.Identity
@using WorkFlowBasic.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Genel Bakış";
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : User.Identity?.Name;

    // Hitap Şekli Belirleme
    string greeting = "Hoşgeldin";
    if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        greeting = "Hoşgeldin Patron";
    }
}

<div class="row mb-4">
    <div class="col-12">
        <h3>👋 @greeting, <span class="text-primary">@fullName</span></h3>
        <p class="text-muted">İş akış özetin ve durum raporun aşağıdadır.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-2">Toplam Talep</h6>
                <h2 class="mb-0 text-primary">@ViewBag.TotalCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-2">Onay Bekleyen</h6>
                <h2 class="mb-0 text-warning">@ViewBag.PendingCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-2">Onaylanan</h6>
                <h2 class="mb-0 text-success">@ViewBag.ApprovedCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-2">Reddedilen</h6>
                <h2 class="mb-0 text-danger">@ViewBag.RejectedCount</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">📊 İş Akış Özeti</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.TotalCount == 0)
                {
                    <div class="alert alert-info">Henüz görüntülenecek veri yok.</div>
                }
                else
                {
                    <canvas id="statusChart" style="max-height: 300px;"></canvas>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">⚡ Hızlı İşlemler</h5>
            </div>
            <div class="card-body d-grid gap-2">

                @if (User.IsInRole("Personel"))
                {
                    <a href="/Requests/Create" class="btn btn-primary btn-lg text-start">
                        <i class="bi bi-plus-circle-fill me-2"></i> Yeni Talep Oluştur
                    </a>
                    <a href="/Requests/MyRequests" class="btn btn-outline-primary text-start">
                        <i class="bi bi-list-ul me-2"></i> Taleplerimi Gör
                    </a>
                }

                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <a href="/Approvals/Index" class="btn btn-warning btn-lg text-start text-dark">
                        <i class="bi bi-hourglass-split me-2"></i> Onay Bekleyenler (@ViewBag.PendingCount)
                    </a>
                    <a href="/Calendar/Index" class="btn btn-outline-dark text-start">
                        <i class="bi bi-calendar3 me-2"></i> İzin Takvimi
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <hr class="my-2" />
                    <h6 class="text-muted small">Admin Araçları</h6>

                    <a href="/Home/CleanOldData" class="btn btn-secondary text-start" onclick="return confirm('1 aydan eski ve tamamlanmış talepler silinecek. Onay bekleyenlere dokunulmayacak. Devam edilsin mi?')">
                        <i class="bi bi-recycle me-2"></i> Eski Kayıtları Temizle
                    </a>

                    <a href="/Home/ResetSystem" class="btn btn-outline-danger text-start" onclick="return confirm('DİKKAT! Veritabanındaki TÜM TALEPLER silinecek. Bu işlem geri alınamaz. Emin misiniz?')">
                        <i class="bi bi-trash3-fill me-2"></i> Sistemi Sıfırla (Demo Reset)
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var pending = @ViewBag.PendingCount;
        var approved = @ViewBag.ApprovedCount;
        var rejected = @ViewBag.RejectedCount;

        if (pending + approved + rejected > 0) {
            var ctx = document.getElementById('statusChart').getContext('2d');
            var myChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Bekleyen', 'Onaylanan', 'Reddedilen'],
                    datasets: [{
                        data: [pending, approved, rejected],
                        backgroundColor: [
                            '#ffc107', // Sarı
                            '#198754', // Yeşil
                            '#dc3545'  // Kırmızı
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    </script>
}