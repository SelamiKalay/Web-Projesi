@model IEnumerable<WorkFlowBasic.Models.WorkflowRequest>

@{
    ViewData["Title"] = "Taleplerim";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>📋 Taleplerim</h3>

        @if (User.IsInRole("Personel"))
        {
            <a href="/Requests/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Talep</a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tür</th>
                        <th>Başlık</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>Onaycı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-info text-dark">@item.ProcessDefinition?.ProcessName</span></td>
                            <td>@item.RequestTitle</td>
                            <td>@item.CreatedDate.ToShortDateString()</td>
                            <td>
                                @if (item.Status == WorkFlowBasic.Models.RequestStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                }
                                else if (item.Status == WorkFlowBasic.Models.RequestStatus.Approved)
                                {
                                    <span class="badge bg-success">Onaylandı</span>
                                }
                                else if (item.Status == WorkFlowBasic.Models.RequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Reddedildi</span>
                                }
                            </td>
                            <td>
                                @(item.CurrentApprover?.FullName ?? "-")
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Henüz hiç talep oluşturmadınız.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>