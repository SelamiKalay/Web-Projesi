@model WorkFlowBasic.Models.InventoryItem
@{
    ViewData["Title"] = "Zimmetle";
}

<div class="container mt-5">
    <div class="card shadow-lg border-warning" style="max-width: 500px; margin: 0 auto;">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-box-seam"></i> Zimmet Atama</h5>
        </div>
        <div class="card-body">
            <h4 class="card-title">@Model.ItemName</h4>
            <p class="text-muted">Seri No: @Model.SerialNumber</p>
            <hr />

            <form asp-action="Assign" method="post">
                <input type="hidden" name="itemId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Kime Verilecek?</label>
                    <select name="userId" class="form-select" asp-items="ViewBag.UserList">
                        <option value="">-- Personel Seçiniz --</option>
                    </select>
                </div>

                <div class="alert alert-info small">
                    <i class="bi bi-info-circle"></i> Personel sisteme girdiğinde bu eşyayı onaylaması gerekecektir.
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Atamayı Tamamla</button>
                </div>
            </form>
        </div>
    </div>
</div>