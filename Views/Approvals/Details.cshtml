@model WorkFlowBasic.Models.WorkflowRequest

@{
    ViewData["Title"] = "Talep Detayı";
}

<style>
    /* TIMELINE STİLİ */
    .timeline {
        list-style: none;
        padding: 20px 0 20px;
        position: relative;
    }

        .timeline:before {
            top: 0;
            bottom: 0;
            position: absolute;
            content: " ";
            width: 3px;
            background-color: #eeeeee;
            left: 25px;
            margin-right: -1.5px;
        }

        .timeline > li {
            margin-bottom: 20px;
            position: relative;
        }

            .timeline > li:before, .timeline > li:after {
                content: " ";
                display: table;
            }

            .timeline > li:after {
                clear: both;
            }

            .timeline > li > .timeline-panel {
                width: calc(100% - 65px);
                float: right;
                border: 1px solid #d4d4d4;
                border-radius: 2px;
                padding: 10px;
                position: relative;
                -webkit-box-shadow: 0 1px 6px rgba(0, 0, 0, 0.175);
                box-shadow: 0 1px 6px rgba(0, 0, 0, 0.175);
                background: #fff;
            }

            .timeline > li > .timeline-badge {
                color: #fff;
                width: 50px;
                height: 50px;
                line-height: 50px;
                font-size: 1.4em;
                text-align: center;
                position: absolute;
                top: 0;
                left: 0;
                margin-right: -25px;
                background-color: #999999;
                z-index: 100;
                border-top-right-radius: 50%;
                border-top-left-radius: 50%;
                border-bottom-right-radius: 50%;
                border-bottom-left-radius: 50%;
            }

    .timeline-badge.primary {
        background-color: #0d6efd !important;
    }

    .timeline-badge.success {
        background-color: #198754 !important;
    }

    .timeline-badge.danger {
        background-color: #dc3545 !important;
    }

    /* YAZDIRMA (PRINT) STİLİ - DİKKAT: @@media olarak yazılmalı */
    @@media print {
        .sidebar, .navbar, .btn, footer, .d-print-none, .timeline, .card-header, .chat-btn, .chat-window {
            display: none !important;
        }
        /* TÜRKÇE KARAKTER DÜZELTMESİ */
        body {
            font-family: "Segoe UI", "Arial", "Helvetica", sans-serif !important; /* Güvenli fontlar */
            color: #000 !important;
            -webkit-print-color-adjust: exact;
        }

        .col-md-7, .col-md-10, .content {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            flex: 0 0 100%;
            max-width: 100%;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .bg-light {
            background-color: #fff !important;
            border: 1px solid #ddd !important;
        }

        body::before {
            content: "WORKFLOW RESMİ ONAY BELGESİ - @Model.RequestTitle";
            font-size: 16pt;
            font-weight: bold;
            display: block;
            margin-bottom: 20px;
            text-align: center;
            text-transform: uppercase;
        }

        body::after {
            content: "Onaylayan İmza: _______________________  Tarih: ____/____/______";
            display: block;
            margin-top: 100px;
            text-align: right;
            margin-right: 50px;
        }
    }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary"><i class="bi bi-file-text"></i> Talep Detayları (#@Model.Id)</h5>

                    <button onclick="window.print()" class="btn btn-outline-dark btn-sm d-print-none">
                        <i class="bi bi-printer"></i> Yazdır / PDF
                    </button>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Talep Eden</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Requester.FullName</dd>

                        <dt class="col-sm-4 text-muted">Departman</dt>
                        <dd class="col-sm-8">@Model.Requester.Department</dd>

                        <dt class="col-sm-4 text-muted">Süreç</dt>
                        <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.ProcessDefinition.ProcessName</span></dd>

                        <dt class="col-sm-4 text-muted">Konu</dt>
                        <dd class="col-sm-8">@Model.RequestTitle</dd>

                        <dt class="col-sm-4 text-muted">Tutar</dt>
                        <dd class="col-sm-8">@(Model.Amount.HasValue? Model.Amount.Value.ToString("C2") : "-")</dd>

                        @if (Model.StartDate.HasValue)
                        {
                            <dt class="col-sm-4 text-muted">Tarih Aralığı</dt>
                            <dd class="col-sm-8">@Model.StartDate.Value.ToShortDateString() - @(Model.EndDate.HasValue? Model.EndDate.Value.ToShortDateString() : "?")</dd>
                        }

                        <dt class="col-sm-4 text-muted">Ek Belge</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                            {
                                <a href="@Model.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-secondary d-print-none">
                                    <i class="bi bi-paperclip"></i> Dosyayı Görüntüle
                                </a>
                                <span class="d-none d-print-inline">Ek belge sistemde mevcuttur.</span>
                            }
                            else
                            {
                                <span class="text-muted small">Yok</span>
                            }
                        </dd>
                    </dl>
                    <div class="mt-3 p-3 bg-light rounded text-muted fst-italic border">
                        "@Model.Description"
                    </div>

                    @if (Model.Status == WorkFlowBasic.Models.RequestStatus.Approved)
                    {
                        <div class="mt-4 p-3 border border-success rounded d-none d-print-block">
                            <strong>DURUM:</strong> ONAYLANDI <br />
                            <strong>ONAYLAYAN:</strong> @Model.CurrentApprover?.FullName <br />
                            <strong>ONAY TARİHİ:</strong> @Model.CompletedDate?.ToShortDateString()
                        </div>
                    }
                </div>
            </div>

            <h5 class="mt-4 mb-3 d-print-none">İşlem Tarihçesi</h5>
            <ul class="timeline d-print-none">
                @foreach (var log in Model.Logs.OrderBy(x => x.ActionDate))
                {
                    var badgeClass = "secondary";
                    var iconClass = "bi-circle";

                    if (log.Action == WorkFlowBasic.Models.LogAction.Created) { badgeClass = "primary"; iconClass = "bi-plus-lg"; }
                    else if (log.Action == WorkFlowBasic.Models.LogAction.Approved) { badgeClass = "success"; iconClass = "bi-check-lg"; }
                    else if (log.Action == WorkFlowBasic.Models.LogAction.Rejected) { badgeClass = "danger"; iconClass = "bi-x-lg"; }

                    <li>
                        <div class="timeline-badge @badgeClass"><i class="bi @iconClass"></i></div>
                        <div class="timeline-panel shadow-sm">
                            <div class="d-flex justify-content-between">
                                <h6 class="fw-bold mb-1">@log.Processor.FullName</h6>
                                <small class="text-muted">@log.ActionDate.ToString("g")</small>
                            </div>
                            <p class="mb-0 text-muted">@log.Comments</p>
                        </div>
                    </li>
                }
            </ul>
        </div>

        <div class="col-md-5 d-print-none">
            @if (Model.Status == WorkFlowBasic.Models.RequestStatus.Pending)
            {
                <div class="card shadow border-0 sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-shield-check"></i> Yönetici Paneli</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Process" method="post">
                            <input type="hidden" name="requestId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-bold">Karar Notunuz</label>
                                <textarea name="comments" class="form-control" rows="4" required></textarea>
                            </div>
                            <div class="row g-2">
                                <div class="col-6"><button type="submit" name="decision" value="Approve" class="btn btn-success w-100 py-2">ONAYLA</button></div>
                                <div class="col-6"><button type="submit" name="decision" value="Reject" class="btn btn-danger w-100 py-2">REDDET</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Bu talep <strong>@Model.Status</strong> durumundadır. İşlem yapılamaz.
                </div>
            }
        </div>
    </div>
</div>